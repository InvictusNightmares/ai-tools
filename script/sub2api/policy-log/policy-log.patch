+// Uses harmless fixture bodies and synthetic upstream marks; no live model call.
+func TestPolicyRequestRecorderIsConditionalAndTurnScoped(t *testing.T) {
+	c := newTestGinContext()
+	c.Request = httptest.NewRequest("POST", "/openai/v1/responses", nil)
+	c.Writer.Header().Set("X-Request-Id", "synthetic-request-id")
+	var entries []requestcontent.Entry
+	h := &OpenAIGatewayHandler{policyRequestRecorder: func(e requestcontent.Entry) {
+		e.Body = append([]byte(nil), e.Body...)
+		entries = append(entries, e)
+	}}
+	gid := int64(198)
+	key := &service.APIKey{ID: 65, Name: "synthetic-owner", GroupID: &gid, User: &service.User{ID: 9}, Group: &service.Group{Name: "codex-D"}}
+	account := &service.Account{ID: 51}
+	body := []byte(`{"input":"harmless text mentioning cyber_policy"}`)
+	h.recordCyberPolicyIfMarked(c, key, account, nil, "gpt-5", false, body, service.ChannelUsageFields{}, "")
+	require.Empty(t, entries, "normal responses must never capture the request")
+	service.MarkOpsCyberPolicy(c, service.CyberPolicyMark{UpstreamStatus: 200})
+	h.recordCyberPolicyIfMarked(c, key, account, nil, "gpt-5", false, body, service.ChannelUsageFields{}, "")
+	h.recordCyberPolicyIfMarked(c, key, account, nil, "gpt-5", false, body, service.ChannelUsageFields{}, "")
+	require.Len(t, entries, 1, "duplicate callback for the same turn must not duplicate content")
+	require.Equal(t, "cyber_policy", entries[0].ErrorCode)
+	require.Equal(t, 200, entries[0].UpstreamStatus, "HTTP 200 SSE policy errors must be captured")
+	require.Equal(t, int64(65), entries[0].APIKeyID)
+	require.Equal(t, int64(51), entries[0].AccountID)
+	require.Equal(t, "synthetic-owner", entries[0].APIKeyName)
+	require.Equal(t, "synthetic-request-id", entries[0].RequestID)
+	require.Equal(t, string(body), string(entries[0].Body))
+	clearCyberPolicyTurnState(c)
+	c.Request.Header.Set("Upgrade", "websocket")
+	h.recordCyberPolicyIfMarked(c, key, account, nil, "gpt-5", false, []byte(`{"input":"normal next turn"}`), service.ChannelUsageFields{}, "")
+	require.Len(t, entries, 1, "a normal next turn must not inherit the previous rejection")
+	service.MarkOpsCyberPolicy(c, service.CyberPolicyMark{UpstreamStatus: 400})
+	h.recordCyberPolicyIfMarked(c, key, account, nil, "gpt-5", true, []byte(`{"input":"second rejected turn"}`), service.ChannelUsageFields{}, "")
+	require.Len(t, entries, 2)
+	require.Equal(t, `{"input":"second rejected turn"}`, string(entries[1].Body))
+	require.Equal(t, "websocket", entries[1].Protocol)
+}
