#!/usr/bin/env python3
"""agent-run: dispatch one task card to a worker agent and collect a verifiable result.

Workers:
  deepseek  Claude Code harness, model deepseek-flash via an Anthropic-compatible gateway
            (GATEWAY_BASE_URL and GATEWAY_API_KEY must be exported in ~/.zshrc)
  codex     official codex CLI (ChatGPT login)

Usage:
  agent-run <worker> <task-card.md> [--dir DIR] [--mode rw|ro|cu] [--name NAME]
            [--test CMD] [--timeout SEC] [--model MODEL] [--net] [--add-dir DIR]
            [--apps APP,APP] [--skip-app-check] [--auto-approve]

Modes:
  rw  (default) if DIR is a git repo: new worktree + branch agent/<worker>/<name> from HEAD;
      the worker's changes are committed there for review. Otherwise runs in DIR in place.
  ro  runs in DIR itself with read-only tools / sandbox.
  cu  computer use (desktop apps, browser, GUI). codex only. Runs in a scratch dir inside the
      run dir; the worker drives the real desktop through codex's computer-use plugins.

Permissions are declared at dispatch time so codex never stalls on an approval mid-run:
  --net          codex only: allow network for the worker's shell commands
  --add-dir DIR  codex only: extra writable directory (repeatable)
  --apps A,B     cu only: apps the task will drive. Each must already be approved for codex
                 computer use (learned in ~/.agent-runs/approved-apps.json from earlier runs);
                 unknown apps stop the run (exit 3) and print the command the user runs once
                 in a terminal to approve them. --skip-app-check runs anyway.
  After a cu run, apps codex could open are added to approved-apps.json and apps it was
  refused are reported as blocked_apps with the approval command.

--auto-approve (codex only, rw/cu): run codex with --approve-for-me, so approval requests
  (sandbox escalations, computer-use app access) are decided by codex's own reviewer instead
  of failing. Implies the workspace-write sandbox.

Every run gets ~/.agent-runs/<stamp>-<name>-<worker>/ with task.md, report.md (worker's
final message), worker.out/.err (raw, streamed), live.log (readable progress, streamed),
test.log and meta.json. The last stdout line is the meta path. When stderr is a terminal the
progress is also printed live.

Watching:
  agent-run watch [NAME|RUN_DIR]   follow a run's live.log until it finishes (default: newest run)
"""
import argparse, datetime, json, os, re, shutil, subprocess, sys, threading, time
from pathlib import Path

RUNS_ROOT = Path.home() / ".agent-runs"
APPROVED_APPS = RUNS_ROOT / "approved-apps.json"
CLAUDE = str(Path.home() / ".local/bin/claude")
CLEAN_PATH = f"/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:{Path.home()}/.local/bin"

WORKER_PREAMBLE = """You are a worker agent dispatched by an orchestrator. Rules:
- Work only inside the current working directory. Do not touch files outside it.
- Never run git commit, git push, git reset, git checkout of other branches, or delete the repo's history.
- Do not modify tests you were told not to modify. Do not weaken tests to make them pass.
- If something blocks you, stop and say exactly what is blocking; do not guess.
- Finish with a report in exactly this shape (Chinese is fine):

## 结论
<one or two sentences: done / partially done / blocked>
## 改动
<files changed and why, or "无">
## 运行的命令
<commands you ran and their outcome>
## 未解决
<open issues, risks, or "无">

--- TASK CARD ---
"""

CU_RULES = """Computer-use rules (you are controlling the user's real desktop):
- Do only what the task card asks, in the apps it names. Do not open unrelated apps, files or sites.
- Never purchase, pay, transfer money, send messages/emails, post or publish anything.
- Never type passwords, keys, or payment/ID numbers, and never sign in or create accounts.
- Never delete files or data, change system/security settings, or accept terms/permissions dialogs.
- If any step needs one of the above or an unexpected dialog appears, stop and report it.
- Leave apps you opened the way the card says (close them if it says nothing).

"""


def sh(cmd, cwd=None, check=True):
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise SystemExit(f"agent-run: {' '.join(cmd)} failed: {r.stderr.strip()}")
    return r.stdout.strip()


def gateway_env():
    # Read gateway URL and key from the user's shell config so neither lives in this repo.
    r = subprocess.run(["zsh", "-ic", 'printf "%s\\n%s" "$GATEWAY_BASE_URL" "$GATEWAY_API_KEY"'],
                       capture_output=True, text=True, env={"HOME": str(Path.home()), "PATH": CLEAN_PATH})
    url, _, key = r.stdout.partition("\n")
    if not url.strip() or not key.strip():
        raise SystemExit("agent-run: export GATEWAY_BASE_URL and GATEWAY_API_KEY in ~/.zshrc")
    return url.strip(), key.strip()


def load_approved():
    try:
        return json.loads(APPROVED_APPS.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def approve_cmd(apps):
    return f'codex "用 computer use 依次打开 {"、".join(apps)}，确认能访问后立即关闭它们，不做其他操作"'


def scan_app_access(out_text):
    """Apps codex opened via computer use, and apps it was refused, from its --json events."""
    ok, blocked = set(), set()
    for line in out_text.splitlines():
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        it = ev.get("item") or {}
        if ev.get("type") != "item.completed" or it.get("type") != "mcp_tool_call":
            continue
        args = it.get("arguments")
        code = args.get("code", "") if isinstance(args, dict) else str(args or "")
        result = json.dumps(it.get("result") or "", ensure_ascii=False)
        refused = {m.strip() for m in re.findall(r"not approved to use ([^\\\"\n.]+)", result)}
        blocked |= refused
        for app in re.findall(r"getApp\(\s*[\"']([^\"']+)[\"']", code):
            if app not in refused:
                ok.add(app)
    return sorted(ok - blocked), sorted(blocked)


def is_git(d):
    return subprocess.run(["git", "-C", str(d), "rev-parse", "--is-inside-work-tree"],
                          capture_output=True).returncode == 0


def build_deepseek(args, workdir, prompt, run):
    model = args.model or "deepseek-flash"
    base_url, key = gateway_env()
    env = {"HOME": str(Path.home()), "USER": os.environ.get("USER", ""), "TERM": "xterm",
           "PATH": CLEAN_PATH, "LANG": "en_US.UTF-8",
           "ANTHROPIC_BASE_URL": base_url, "ANTHROPIC_AUTH_TOKEN": key,
           "ANTHROPIC_MODEL": model, "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
           "ANTHROPIC_DEFAULT_SONNET_MODEL": model, "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
           "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"}
    settings = {"sandbox": {"enabled": True, "autoAllowBashIfSandboxed": True,
                            "allowUnsandboxedCommands": False}}
    cmd = [CLAUDE, "-p", prompt, "--output-format", "stream-json", "--verbose",
           "--settings", json.dumps(settings)]
    if args.mode == "ro":
        cmd += ["--allowedTools", "Read Grep Glob Bash(grep:*) Bash(find:*) Bash(ls:*) Bash(head:*) Bash(wc:*) Bash(cat:*)",
                "--disallowedTools", "Edit Write NotebookEdit WebFetch WebSearch"]
    else:
        cmd += ["--permission-mode", "acceptEdits", "--allowedTools", "Read Write Edit Glob Grep Bash",
                "--disallowedTools", "WebFetch WebSearch"]
    return cmd, env


def build_codex(args, workdir, prompt, run):
    codex = shutil.which("codex")
    node = shutil.which("node")
    if not codex or not node:
        raise SystemExit("agent-run: codex or node not found on PATH")
    path = os.pathsep.join(dict.fromkeys([str(Path(codex).parent), str(Path(node).parent), CLEAN_PATH]))
    env = {"HOME": str(Path.home()), "USER": os.environ.get("USER", ""), "TERM": "xterm",
           "PATH": path, "LANG": "en_US.UTF-8"}
    cmd = [codex, "exec", "--json", "-C", str(workdir),
           *(["--approve-for-me"] if args.auto_approve
             else ["-s", "read-only" if args.mode == "ro" else "workspace-write"]),
           "-o", str(run / "report.md"), "--skip-git-repo-check", "--color", "never"]
    if args.model:
        cmd += ["-m", args.model]
    if args.net:
        cmd += ["-c", "sandbox_workspace_write.network_access=true"]
    for d in args.add_dir:
        cmd += ["--add-dir", str(Path(d).resolve())]
    cmd.append(prompt)
    return cmd, env


def parse_usage(worker, out_text, run):
    meta = {}
    if worker == "deepseek":
        d = None
        for line in out_text.splitlines():
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("type") == "result":
                d = ev
        if d is None:
            return {"parse_error": True}
        (run / "report.md").write_text(d.get("result") or "")
        meta = {"is_error": d.get("is_error"), "num_turns": d.get("num_turns"),
                "session_id": d.get("session_id"),
                "permission_denials": len(d.get("permission_denials") or []),
                "tokens": {m: {"in": u.get("inputTokens"), "out": u.get("outputTokens"),
                               "cache_read": u.get("cacheReadInputTokens")}
                           for m, u in (d.get("modelUsage") or {}).items()}}
    else:
        usage, thread = None, None
        for line in out_text.splitlines():
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            thread = ev.get("thread_id") or thread
            if ev.get("usage"):
                usage = ev["usage"]
        meta = {"thread_id": thread, "tokens": usage}
    return meta


def _short(s, n=160):
    s = " ".join(str(s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def _result_text(result):
    if isinstance(result, dict):
        texts = [c["text"] for c in result.get("content") or [] if isinstance(c, dict) and c.get("text")]
        # computer-use results carry the tool's own instructions as a separate text block
        texts = [t for t in texts if not t.lstrip().startswith("## Computer Use")] or texts
        if texts:
            return texts[0]
    return result if isinstance(result, str) else json.dumps(result or "", ensure_ascii=False)


def render_codex(ev):
    """Readable progress lines for one `codex exec --json` event."""
    t, it = ev.get("type"), ev.get("item") or {}
    kind = it.get("type")
    if t == "item.started":
        if kind == "command_execution":
            return [f"$ {_short(it.get('command'), 200)}"]
        if kind == "mcp_tool_call":
            a = it.get("arguments")
            label = (a.get("title") if isinstance(a, dict) else None) or f"{it.get('server')}.{it.get('tool')}"
            return [f"⚙ {_short(label, 160)} …"]
        return []
    if t == "item.completed":
        if kind == "command_execution":
            out = (it.get("aggregated_output") or "").strip().splitlines()
            lines = [f"  ↳ exit {it.get('exit_code')}"] + [f"    {_short(l)}" for l in out[:4]]
            if len(out) > 4:
                lines.append(f"    … {len(out) - 4} more lines")
            return lines
        if kind == "mcp_tool_call":
            failed = it.get("error") or it.get("status") == "failed"
            return [f"  ↳ {'failed' if failed else 'ok'}: {_short(_result_text(it.get('error') or it.get('result')), 160)}"]
        if kind == "agent_message":
            return [f"💬 {_short(it.get('text'), 600)}"]
        if kind == "reasoning":
            return [f"… {_short(it.get('text'), 200)}"]
        if kind == "file_change":
            return [f"✎ {c.get('kind')} {c.get('path')}" for c in it.get("changes") or []]
        if kind == "web_search":
            return [f"🔎 {_short(it.get('query'))}"]
        if kind == "error":
            return [f"! {_short(it.get('message'), 200)}"]
        return []
    if t == "turn.completed" and ev.get("usage"):
        u = ev["usage"]
        return [f"Σ tokens in {u.get('input_tokens')} (cached {u.get('cached_input_tokens')}) out {u.get('output_tokens')}"]
    if t in ("turn.failed", "error"):
        return [f"! {_short(json.dumps(ev, ensure_ascii=False), 200)}"]
    return []


def render_claude(ev):
    """Readable progress lines for one `claude -p --output-format stream-json` event."""
    t = ev.get("type")
    if t == "system" and ev.get("subtype") == "init":
        return [f"model {ev.get('model')}"]
    if t == "assistant":
        lines = []
        for c in (ev.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and (c.get("text") or "").strip():
                lines.append(f"💬 {_short(c['text'], 600)}")
            elif c.get("type") == "thinking" and c.get("thinking"):
                lines.append(f"… {_short(c['thinking'], 200)}")
            elif c.get("type") == "tool_use":
                inp = c.get("input") or {}
                if c.get("name") == "Bash":
                    lines.append(f"$ {_short(inp.get('command'), 200)}")
                else:
                    arg = inp.get("file_path") or inp.get("pattern") or inp.get("path") or json.dumps(inp, ensure_ascii=False)
                    lines.append(f"⚙ {c.get('name')} {_short(arg, 160)}")
        return lines
    if t == "user":
        lines = []
        for c in (ev.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                body = c.get("content")
                if isinstance(body, list):
                    body = " ".join(x.get("text", "") for x in body if isinstance(x, dict))
                lines.append(f"  ↳ {'error' if c.get('is_error') else 'ok'}: {_short(body)}")
        return lines
    if t == "result":
        return [f"Σ {ev.get('num_turns')} turns · {ev.get('subtype')}"]
    return []


def watch(argv):
    target = argv[0] if argv else None
    if target and Path(target).is_dir():
        candidates = lambda: [Path(target)]
    else:
        pat = re.compile(rf"\d{{8}}-\d{{6}}-{re.escape(target)}-(codex|deepseek)") if target else None
        candidates = lambda: sorted(
            (d for d in (RUNS_ROOT.iterdir() if RUNS_ROOT.exists() else [])
             if d.is_dir() and (d / "task.md").exists() and (not pat or pat.fullmatch(d.name))),
            key=lambda d: d.name)
    run, deadline = None, time.time() + 20
    while run is None and time.time() < deadline:
        running = [d for d in candidates() if not (d / "meta.json").exists()]
        run = running[-1] if running else None
        if run is None:
            time.sleep(1)
    if run is None:
        found = candidates()
        if not found:
            raise SystemExit(f"agent-run watch: no run matching {target or '(any)'}")
        run = found[-1]
    print(f"== {run.name}", flush=True)
    log, pos = run / "live.log", 0
    while True:
        done = (run / "meta.json").exists()
        if log.exists():
            with open(log) as f:
                f.seek(pos)
                chunk = f.read()
                pos = f.tell()
            if chunk:
                print(chunk, end="", flush=True)
        if done:
            break
        time.sleep(0.5)
    meta = json.loads((run / "meta.json").read_text())
    print("== " + json.dumps({k: meta.get(k) for k in ["exit", "duration_s", "test", "branch", "changed_files",
                                                        "blocked_apps"] if meta.get(k) is not None},
                             ensure_ascii=False), flush=True)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "watch":
        return watch(sys.argv[2:])
    p = argparse.ArgumentParser(prog="agent-run")
    p.add_argument("worker", choices=["deepseek", "codex"])
    p.add_argument("card", help="task card markdown file, or - for stdin")
    p.add_argument("--dir", default=".", help="repo or directory to work in (default: cwd)")
    p.add_argument("--mode", choices=["rw", "ro", "cu"], default="rw")
    p.add_argument("--name", help="short task slug (default: card filename)")
    p.add_argument("--test", help="acceptance command run by agent-run in the workdir after the worker exits")
    p.add_argument("--timeout", type=int, default=1800)
    p.add_argument("--model", help="override worker model")
    p.add_argument("--net", action="store_true", help="codex only: allow network in the sandbox")
    p.add_argument("--add-dir", action="append", default=[], help="codex only: extra writable dir (repeatable)")
    p.add_argument("--apps", help="cu only: comma-separated apps the task will drive")
    p.add_argument("--skip-app-check", action="store_true", help="cu only: run even if --apps has unapproved apps")
    p.add_argument("--auto-approve", action="store_true",
                   help="codex only: let codex's reviewer approve escalations instead of failing")
    args = p.parse_args()
    if args.mode == "cu" and args.worker != "codex":
        raise SystemExit("agent-run: computer-use tasks (--mode cu) go to codex only")
    if args.auto_approve and (args.worker != "codex" or args.mode == "ro"):
        raise SystemExit("agent-run: --auto-approve is for codex in rw or cu mode only")
    if args.mode != "cu" and not Path(args.dir).is_dir():
        raise SystemExit(f"agent-run: --dir {args.dir} is not a directory")
    if (args.net or args.add_dir) and (args.worker != "codex" or args.mode == "ro"):
        raise SystemExit("agent-run: --net/--add-dir are for codex in rw or cu mode only")
    if args.apps and args.mode != "cu":
        raise SystemExit("agent-run: --apps only applies to --mode cu")
    apps = [a.strip() for a in (args.apps or "").split(",") if a.strip()]
    if apps and not args.skip_app_check:
        known = {k.lower() for k in load_approved()}
        unknown = [a for a in apps if a.lower() not in known]
        if unknown:
            print(json.dumps({"preflight": "unapproved_apps", "apps": unknown,
                              "approve_cmd": approve_cmd(unknown)}, ensure_ascii=False))
            print(f"agent-run: not yet approved for codex computer use: {', '.join(unknown)}. "
                  "The user must run approve_cmd once in a terminal and choose always allow.", file=sys.stderr)
            sys.exit(3)

    card = sys.stdin.read() if args.card == "-" else Path(args.card).read_text()
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", args.name or Path(args.card).stem if args.card != "-" else args.name or "task").strip("-") or "task"
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    run = RUNS_ROOT / f"{stamp}-{name}-{args.worker}"
    run.mkdir(parents=True)
    (run / "task.md").write_text(card)

    src = Path(args.dir).resolve()
    meta = {"worker": args.worker, "name": name, "mode": args.mode, "src": str(src),
            "run_dir": str(run), "started": stamp, "auto_approve": args.auto_approve,
            "net": args.net, "add_dir": args.add_dir, "apps": apps}

    workdir, branch, base = src, None, None
    if args.mode == "cu":
        workdir = run / "cu"
        workdir.mkdir()
    if args.mode == "rw" and is_git(src):
        top = Path(sh(["git", "-C", str(src), "rev-parse", "--show-toplevel"]))
        rel = src.relative_to(top)
        base = sh(["git", "-C", str(top), "rev-parse", "HEAD"])
        branch = f"agent/{args.worker}/{name}-{stamp}"
        wt = run / "worktree"
        sh(["git", "-C", str(top), "worktree", "add", "-q", "-b", branch, str(wt), base])
        workdir = wt / rel
        meta.update(repo=str(top), branch=branch, base=base, worktree=str(wt))
    meta["workdir"] = str(workdir)

    prompt = WORKER_PREAMBLE + (CU_RULES if args.mode == "cu" else "") + card
    builder = build_deepseek if args.worker == "deepseek" else build_codex
    cmd, env = builder(args, workdir, prompt, run)

    live = open(run / "live.log", "a", buffering=1)
    echo = sys.stderr.isatty()

    def emit(lines):
        for ln in lines:
            s = f"{time.strftime('%H:%M:%S')} {ln}"
            live.write(s + "\n")
            if echo:
                print(s, file=sys.stderr, flush=True)

    render = render_codex if args.worker == "codex" else render_claude
    emit([f"▶ {args.worker} · {args.mode} · {name} · {workdir}"])
    t0, out_lines, code = time.time(), [], None
    try:
        with open(run / "worker.out", "w") as fout, open(run / "worker.err", "w") as ferr:
            proc = subprocess.Popen(cmd, cwd=workdir, env=env, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=ferr, text=True, bufsize=1)
            fired = []
            timer = threading.Timer(args.timeout, lambda: (fired.append(1), proc.kill()))
            timer.start()
            for line in proc.stdout:
                fout.write(line)
                fout.flush()
                out_lines.append(line)
                try:
                    emit(render(json.loads(line)))
                except Exception:
                    pass
            code = proc.wait()
            timer.cancel()
            if fired:
                code = "timeout"
                ferr.write("\nagent-run: TIMEOUT\n")
    except OSError as e:
        code = "start_failed"
        (run / "worker.err").write_text(f"agent-run: failed to start worker: {e}")
    out = "".join(out_lines)
    meta["duration_s"] = round(time.time() - t0, 1)
    meta["exit"] = code
    emit([f"■ worker exit {code} · {meta['duration_s']}s"])
    meta.update(parse_usage(args.worker, out, run))
    if not (run / "report.md").exists():
        (run / "report.md").write_text("")

    if args.mode == "cu":
        ok_apps, blocked_apps = scan_app_access(out)
        if ok_apps:
            approved = load_approved()
            for a in ok_apps:
                approved.setdefault(a, stamp)
            APPROVED_APPS.write_text(json.dumps(approved, ensure_ascii=False, indent=2))
        meta.update(apps_ok=ok_apps, blocked_apps=blocked_apps)
        if blocked_apps:
            meta["approve_cmd"] = approve_cmd(blocked_apps)

    if args.test:
        t = subprocess.run(["zsh", "-c", args.test], cwd=workdir, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           env={**env, "ANTHROPIC_AUTH_TOKEN": ""})
        (run / "test.log").write_text(f"$ {args.test}\n{t.stdout}{t.stderr}")
        meta["test"] = {"cmd": args.test, "exit": t.returncode, "passed": t.returncode == 0}
        emit([f"✓ test passed: {args.test}" if t.returncode == 0 else f"✗ test failed (exit {t.returncode}): {args.test}"])

    if branch:
        wt = Path(meta["worktree"])
        status = sh(["git", "-C", str(wt), "status", "--porcelain"])
        head_now = sh(["git", "-C", str(wt), "rev-parse", "HEAD"])
        meta["worker_committed"] = head_now != base
        if status:
            sh(["git", "-C", str(wt), "add", "-A"])
            sh(["git", "-C", str(wt), "commit", "-q", "-m", f"agent-run({args.worker}): {name}"])
        meta["diffstat"] = sh(["git", "-C", str(wt), "diff", "--stat", base, "HEAD"])
        meta["changed_files"] = sh(["git", "-C", str(wt), "diff", "--name-only", base, "HEAD"]).splitlines()

    if meta.get("blocked_apps"):
        emit([f"! apps not approved: {', '.join(meta['blocked_apps'])} → {meta['approve_cmd']}"])
    if meta.get("diffstat"):
        emit([f"✎ {l}" for l in meta["diffstat"].splitlines()])
    emit([f"● done → {run / 'meta.json'}"])
    live.close()
    (run / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2))
    print(json.dumps({k: meta.get(k) for k in ["worker", "name", "exit", "duration_s", "test", "branch",
                                                 "changed_files", "permission_denials", "blocked_apps",
                                                 "approve_cmd"] if meta.get(k) is not None}, ensure_ascii=False))
    print(run / "meta.json")


if __name__ == "__main__":
    main()
