user nginx;
worker_processes 1;
pid /var/run/nginx.pid;
events { worker_connections 1024; }

stream {
    resolver {{DOCKER_DNS_IP}} valid=10s ipv6=off;
    map $ssl_preread_server_name $web_backend {
{{SNI_ROUTES}}
        default 127.0.0.1:{{RAW_PORT}};
    }
    server {
        listen {{HTTPS_PORT}};
        ssl_preread on;
        proxy_protocol on;
        proxy_pass $web_backend;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }
    map $server_addr $raw_backend {
        default {{RAW_BACKEND}};
    }
    server {
        listen 127.0.0.1:{{RAW_PORT}} proxy_protocol;
        proxy_protocol off;
        proxy_pass $raw_backend;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_request_buffering off;
    client_max_body_size 64m;
    include {{HTTP_POLICY_GLOB}};
    server {
        listen {{HTTP_PORT}} default_server;
        server_name _;
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/acme;
            default_type text/plain;
            try_files $uri =404;
        }
        location / { return 301 https://$host$request_uri; }
    }
    server {
        listen 127.0.0.1:{{TLS_PORT}} ssl proxy_protocol default_server;
        server_name _;
        ssl_reject_handshake on;
    }
    include {{HTTP_VHOSTS_GLOB}};
}
