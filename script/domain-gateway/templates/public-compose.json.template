{
  "services": {
    "gateway": {
      "image": "{{NGINX_IMAGE}}",
      "container_name": "{{CONTAINER_NAME}}",
      "restart": "unless-stopped",
      "ports": ["{{HTTP_PORT}}:{{HTTP_PORT}}/tcp", "{{HTTPS_PORT}}:{{HTTPS_PORT}}/tcp"],
      "volumes": [
        "./nginx.conf:/etc/nginx/nginx.conf:ro",
        "./sites:/etc/nginx/sites:ro",
        "./policies:/etc/nginx/policies:ro",
        "{{CERT_DIRECTORY}}:/etc/nginx/domain-certs:ro",
        "{{WEBROOT_DIRECTORY}}:/var/www/acme:ro"
      ],
      "networks": ["backend"],
      "logging": {"driver": "local", "options": {"max-size": "10m", "max-file": "3"}}
    }
  },
  "networks": {"backend": {"external": true, "name": "{{DOCKER_NETWORK}}"}}
}
