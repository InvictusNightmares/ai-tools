# Copy to a private .env file; never commit real credentials.
CPA_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_USERS=
# Set after pairing, using the owner's private chat ID (oc_...), not open_id.
FEISHU_HOME_CHANNEL=
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_GROUP_POLICY=disabled
FEISHU_ALLOW_BOTS=none
FEISHU_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
HERMES_YOLO_MODE=0
# Dashboard login. Runtime may use PASSWORD_HASH instead of plaintext PASSWORD.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=invictus
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# install.sh derives BROWSER_CDP_URL from the existing private Chrome client.env.
