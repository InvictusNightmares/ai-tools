#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUNDLED_NODE="/Users/invictus/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"

if command -v node >/dev/null 2>&1; then
  NODE_BIN="$(command -v node)"
elif [ -x "$BUNDLED_NODE" ]; then
  NODE_BIN="$BUNDLED_NODE"
else
  echo "node was not found in PATH, and bundled Node is unavailable: $BUNDLED_NODE" >&2
  exit 127
fi

exec "$NODE_BIN" "$SCRIPT_DIR/chat-probe.mjs" "$@"
