worker_processes 1;
pid /tmp/nginx.pid;
error_log /logs/error.log warn;

events { worker_connections 2048; }

http {
    server_tokens off;
    map $http_upgrade $connection_upgrade { default upgrade; "" ""; }
    upstream regional_sub2api { server @UPSTREAM_AUTHORITY@; keepalive 128; }
    log_format gateway escape=json
      '{"at":"$time_iso8601","method":"$request_method","path":"$uri",'
      '"status":$status,"elapsed_s":$request_time,"upstream_status":"$upstream_status",'
      '"request_id":"$upstream_http_x_gateway_request_id"}';
    access_log /logs/access.jsonl gateway;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 200m;
    client_body_timeout 60s;
    send_timeout 3600s;
    proxy_http_version 1.1;
    proxy_set_header Host @UPSTREAM_AUTHORITY@;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Gateway-Client-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-API-Key $http_x_api_key;
    proxy_set_header anthropic-version $http_anthropic_version;
    proxy_set_header anthropic-beta $http_anthropic_beta;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;

    server {
        listen @BIND_ADDRESS@:@PORT@;
        server_name _;

        location = /healthz { proxy_pass http://127.0.0.1:@AUTO_PORT@; }

        # Read-only user billing endpoints keep Sub2API's original semantics.
        # In particular exhausted keys must still be able to view their usage.
        location = /v1/usage { proxy_pass http://regional_sub2api; }
        location = /v1/sub2api/billing { proxy_pass http://regional_sub2api; }

        # All model API paths go through the gateway, including native aliases.
        # Unsupported generation protocols must not escape to a raw upstream.
        location /v1/ { proxy_pass http://127.0.0.1:@AUTO_PORT@; }
        location ~ ^/(models|responses(?:/.*)?|chat/completions|messages(?:/count_tokens)?|files(?:/.*)?|images/(?:generations|edits)|audio/(?:transcriptions|translations|speech))$ {
            rewrite ^/(.*)$ /v1/$1 break;
            proxy_pass http://127.0.0.1:@AUTO_PORT@;
        }
        location /backend-api/codex/ {
            rewrite ^/backend-api/codex/(.*)$ /v1/$1 break;
            proxy_pass http://127.0.0.1:@AUTO_PORT@;
        }
        location ~ ^/(v1beta|antigravity|videos|embeddings|alpha)(/|$) {
            default_type application/json;
            return 501 '{"error":{"type":"gateway_capability_unavailable","message":"This API is not yet supported by the guarded gateway"}}';
        }
        location = /metrics { return 404; }
        location = /_gateway { return 404; }
        location ^~ /_gateway/ { return 404; }
        location = /logs { return 404; }
        location ^~ /logs/ { return 404; }

        # Preserve the existing website, account/Key administration and login.
        location / {
            proxy_pass http://regional_sub2api;
        }
    }
}
