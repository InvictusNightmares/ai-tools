    {
      "id": "broad-design",
      "source": "synthetic",
      "expected_task": "architecture",
      "reviewer_complexity": "complex",
      "variants": {
        "zh": {
          "messages": [
            {
              "role": "user",
              "content": "为移动应用设计跨端会话管理改造：覆盖退出、重登、旧请求晚到、多窗口、网页桥接与离线重试；明确一致性约束，比较两种方案，给出分阶段迁移、回滚条件和可验证的回归矩阵。"
            }
          ]
        },
        "en": {
          "messages": [
            {
              "role": "user",
              "content": "Design cross-platform session management for a mobile app: handle logout, re-login, late responses, multiple windows, web bridges and offline retries; define consistency constraints, compare two approaches, and specify migration stages, rollback conditions and a verifiable regression matrix."
            }
          ]
        },
        "mixed": {
          "messages": [
            {
              "role": "user",
              "content": "设计跨端 session management：logout、re-login、late response、multi-window、WebBridge、offline retry；明确 consistency，比较两种方案，给出 migration、rollback 和 regression matrix。"
            }
          ]
        }
      }
    },
