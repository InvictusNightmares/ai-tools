    {
      "id": "short-hard",
      "source": "synthetic",
      "expected_task": "debugging",
      "reviewer_complexity": "complex",
      "variants": {
        "zh": {
          "messages": [
            {
              "role": "user",
              "content": "退出与重新登录并发时，旧请求回包会覆盖新用户状态，如何证明修复在所有交错顺序下都正确？"
            }
          ]
        },
        "en": {
          "messages": [
            {
              "role": "user",
              "content": "When logout races with a new login, an old response overwrites the new user state. How can we prove a fix is correct for every interleaving?"
            }
          ]
        },
        "mixed": {
          "messages": [
            {
              "role": "user",
              "content": "logout 与 re-login 并发，旧 response 覆盖新 session，如何证明所有 interleaving 都正确？"
            }
          ]
        }
      }
    },
