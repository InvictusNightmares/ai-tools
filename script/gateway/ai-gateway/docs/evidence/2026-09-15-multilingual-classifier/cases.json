    {
      "id": "network",
      "source": "historical-reconstruction",
      "expected_task": "debugging",
      "reviewer_complexity": "cross-layer",
      "variants": {
        "zh": {
          "messages": [
            {
              "role": "user",
              "content": "断网时没有错误提示。排查统一网络层，区分连接超时、传输异常和业务错误，并保留后台请求的静默开关。"
            }
          ]
        },
        "en": {
          "messages": [
            {
              "role": "user",
              "content": "Offline requests show no error message. Debug the shared network layer, distinguish connection timeouts, transport failures and business errors, and preserve quiet background requests."
            }
          ]
        },
        "mixed": {
          "messages": [
            {
              "role": "user",
              "content": "断网时没有 error toast。排查 HttpClient，区分 timeout、transport exception 和 BusinessError，保留后台请求静默开关。"
            }
          ]
        }
      }
    },
    {
      "id": "logout",
      "source": "historical-reconstruction",
      "expected_task": "debugging",
      "reviewer_complexity": "cross-layer",
      "variants": {
        "zh": {
          "messages": [
            {
              "role": "user",
              "content": "退出登录后重启应用又回到主页面。请追踪登录信息写入、启动读取和所有跳转登录入口，统一清理用户状态并验证冷启动。"
            }
          ]
        },
        "en": {
          "messages": [
            {
              "role": "user",
              "content": "After logout, restarting the app opens the main page again. Trace saved login data, startup reads and every navigation-to-login entry point; centralize session cleanup and verify cold starts."
            }
          ]
        },
        "mixed": {
          "messages": [
            {
              "role": "user",
              "content": "logout 后重启又进入 Main。追踪 Login 写入、Splash 读取和 Navigation 登录入口，统一清理 session 并验证 cold start。"
            }
          ]
        }
      }
    },
    {
      "id": "release",
      "source": "historical-reconstruction",
      "expected_task": "audit",
      "reviewer_complexity": "cross-layer",
      "variants": {
        "zh": {
          "messages": [
            {
              "role": "user",
              "content": "审查上架前的应用发布包，核对签名证书层级、最终权限、第三方组件合并的权限以及相机实际调用链，区分本地检查和真机验收。"
            }
          ]
        },
        "en": {
          "messages": [
            {
              "role": "user",
              "content": "Audit the app release package: verify signing certificate levels, final permissions, permissions merged from dependencies and camera call paths; distinguish local checks from device acceptance."
            }
          ]
        },
        "mixed": {
          "messages": [
            {
              "role": "user",
              "content": "审查 release 包：certificate chain、最终 permissions、HAR 合并权限、camera 调用链，区分 local check 和 device acceptance。"
            }
          ]
        }
      }
    },
