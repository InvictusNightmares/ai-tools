[Unit]
Description=Local work observation analysis (no network or business tools)

[Service]
Type=oneshot
User=work-observation
Group=work-observation
ExecStart=/usr/bin/python3 /opt/work-observation/current/tools/rolling.py --config /etc/work-observation/rolling.json
UMask=0077
Nice=15
CPUQuota=25%
MemoryMax=512M
TasksMax=16
TimeoutStartSec=90
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=false
ReadOnlyPaths=/data/work-observation/tokyo /data/work-observation/us
ReadWritePaths=/data/work-observation/analysis
# The worker may call only loopback semantic-preview endpoints. The deny rule
# keeps the analysis process from reaching public or production networks.
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
