[Unit]
Description=Work-observation rolling metadata and semantic review worker
After=work-observation-analysis-token-sync.service
Requires=work-observation-analysis-token-sync.service

[Service]
Type=oneshot
User=work-observation
Group=work-observation
UMask=0077
WorkingDirectory=/opt/work-observation/current
ExecStart=/usr/bin/python3.11 /opt/work-observation/current/tools/rolling.py --config /etc/work-observation/rolling.json
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
PrivateNetwork=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
ReadOnlyPaths=/etc/work-observation/rolling.json /data/work-observation/tokyo /data/work-observation/us /opt/work-observation/current
ReadWritePaths=/data/work-observation/analysis

[Install]
WantedBy=multi-user.target
